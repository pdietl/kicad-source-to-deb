+bool KIPLATFORM::UI::IsScreenComposited( wxWindow* aWindow )
+{
+    if( !aWindow )
+        return false;
+
+    GdkScreen* screen = gtk_widget_get_screen( static_cast<GtkWidget*>( aWindow->GetHandle() ) );
+
+    return screen && gdk_screen_is_composited( screen );
+}
